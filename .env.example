# Agent-Feedback-API — environment variables
# Copy this file to .env.local for local development; never commit real values.
# Production + preview values live in the Vercel project's env-var settings.

# Featurebase API key (Bearer token used to call Featurebase server-to-server).
# Obtain from Featurebase Settings → API. Treat as a high-stakes secret.
FEATUREBASE_API_KEY=

# ObjectId of the operator's single Featurebase board (where all posts land).
FEATUREBASE_BOARD_ID=

# ObjectId of the Featurebase custom field of type "select" used to encode
# the post category (Bug / Feature request / Feedback).
FEATUREBASE_FIELD_TYPE_ID=

# Static shared token baked into the agent bundle. The proxy compares the
# incoming `Authorization: Bearer <token>` header against this value.
# Low-stakes (POST-only); rotate annually + on suspected leak.
FEEDBACK_BUNDLE_TOKEN=

# OPTIONAL — operator's Featurebase public portal URL (e.g.
# https://feedback.<operator>.featurebase.app). When set, the proxy
# constructs `post_url` as `<portal>/p/<slug>`. When unset, the proxy
# returns whatever URL/slug Featurebase's API supplies directly.
FEATUREBASE_PORTAL_URL=
