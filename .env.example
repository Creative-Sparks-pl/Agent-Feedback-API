# Agent-Feedback-API — environment variables
# Copy this file to .env.local for local development; never commit real values.
# Production + preview values live in the Vercel project's env-var settings.

# Static shared token baked into the agent bundle. The proxy compares the
# incoming `Authorization: Bearer <token>` header against this value.
# Low-stakes (POST-only); rotate annually + on suspected leak.
FEEDBACK_BUNDLE_TOKEN=

# GitHub fine-grained Personal Access Token, scoped to the operator's
# feedback repo only, with `Discussions: read and write` permission. Treat
# as a high-stakes secret — rotate via GitHub UI on suspected leak.
GITHUB_TOKEN=

# GraphQL global node ID of the operator's feedback repo. Fetch once at
# setup time:
#   gh api graphql -f query='query{repository(owner:"OWNER",name:"REPO"){id}}'
GITHUB_REPO_ID=

# Discussion category IDs — one per agent `type`. Fetch once at setup time:
#   gh api graphql -f query='query{repository(owner:"OWNER",name:"REPO"){
#     discussionCategories(first:20){nodes{id name}}}}'
# Map each category by its `name` to the matching env var below.
GITHUB_CAT_BUG_ID=
GITHUB_CAT_FEATURE_ID=
GITHUB_CAT_FEEDBACK_ID=

# Make.com webhook URL for the email-relay scenario. When set, the proxy
# fires a POST after each successful Discussion creation that carries a
# reply-to email — Make's scenario reads the payload and sends a Gmail to
# the operator with the user's email as Reply-To. If unset, the email
# relay is skipped (Discussion still lands; operator just doesn't get an
# inbox notification). See docs/operations.md §2 for Make scenario setup.
MAKE_WEBHOOK_URL=

# Make.com webhook API key — sent as `x-make-apikey` header. Prevents
# anyone who learns the webhook URL from firing the scenario. Generate
# any random string; configure it in Make's webhook settings.
MAKE_API_KEY=
